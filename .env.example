# supellex — configuration. Copier en .env puis remplir ; .env est gitignoré.
# Générer chaque secret aléatoirement, ex. : openssl rand -base64 32
# (ne jamais choisir de valeur à la main, ne jamais commiter de secret).

# ---- Base de données PostgreSQL ----
# Mot de passe de l'utilisateur supellex (docker compose le lit aussi pour POSTGRES_PASSWORD).
POSTGRES_PASSWORD=changez-moi
# URL complète (dev hors docker ; en compose, l'URL interne est reconstruite
# automatiquement depuis POSTGRES_PASSWORD) :
DATABASE_URL=postgres://supellex:changez-moi@localhost:5432/supellex

# ---- Authentification ----
# Secret de signature des JWT (min. 32 caractères aléatoires).
JWT_SECRET=changez-moi
# Durée de vie du token (secondes).
JWT_TTL_SECONDS=3600
# Compte admin créé au premier démarrage (mot de passe à changer au premier login).
ADMIN_EMAIL=admin@supellex.local
ADMIN_INITIAL_PASSWORD=changez-moi
# Rate limiting anti force brute sur /auth/login (par IP, fenêtre glissante).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

# ---- Chiffrement au repos ----
# Clé AES-256 (base64 de 32 octets) : secrets des appareils réseau (SSH/API)
# ET secrets des fournisseurs d'auth (bind LDAP, client_secret OIDC).
# openssl rand -base64 32
DEVICES_ENCRYPTION_KEY=changez-moi

# ---- Réseau / déploiement ----
# Port d'écoute de l'API (publié sur 127.0.0.1 en compose).
API_PORT=8080
# Port du front (BFF Next.js).
WEB_PORT=3000
# URL publique du front, ex. https://supellex.example.com : sert à construire le
# redirect_uri OIDC par défaut : <PUBLIC_BASE_URL>/api/auth/oidc/callback
PUBLIC_BASE_URL=http://localhost:3000
# Origines autorisées pour le CORS (séparées par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Front -> API (dev hors docker ; en compose : http://api:8080, posé par compose).
API_INTERNAL_URL=http://localhost:8080

# ---- Journalisation ----
RUST_LOG=info,supellex_api=info

# ---- Découverte réseau (balayage ping façon PHPIPAM) ----
# Intervalle du balayage automatique en secondes (0 = désactivé).
PING_INTERVAL_SECONDS=300
# Timeout d'un ping en millisecondes.
PING_TIMEOUT_MS=1000
# Nombre de pings simultanés.
PING_CONCURRENCY=32
# Nombre max d'hôtes balayés lors d'un scan à la demande.
SCAN_MAX_HOSTS=4096
